# Test environment, used when APP_ENV=TEST: the fake Keitaro service and the test database
# from docker/docker-compose-test.yml. No real secrets here, so the file is kept in git.
# These values are for running the app on the host; inside docker-compose-test.yml
# the hosts are replaced with container names.

DATABASE_URL=postgresql+psycopg://adrobot:adrobot@localhost:5433/adrobot_test

# Fake Keitaro (tests/keitaro_service), same Admin API as the real tracker
KEITARO_URL=http://localhost:8081
KEITARO_API_KEY=test-api-key
KEITARO_TIMEOUT_S=10

CAMPAIGN_DOMAIN=in.posdk.xyz
CAMPAIGN_GROUP=FORTESTS
CAMPAIGN_SOURCE=FORTESTS
CAMPAIGN_GEO_REDIRECT_URL=https://google.com
