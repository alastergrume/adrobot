# Production settings, used when APP_ENV=PRODUCTION (the default).
# Copy to app/configs/.env and fill in. Environment variables override values from the file.
# Test settings (fake Keitaro, test database) are in app/configs/.env_test.

# PostgreSQL started by: docker compose -f docker/docker-compose.yml up -d db
# (when the app itself runs in Docker Compose, this value is overridden to use the "db" service)
DATABASE_URL=postgresql+psycopg://adrobot:adrobot@localhost:5432/adrobot

# Keitaro Admin API: tracker address and the key from Profile -> API keys
KEITARO_URL=https://your-tracker.example
KEITARO_API_KEY=
KEITARO_TIMEOUT_S=20
# Address of the Keitaro admin for "View in KT" links, if it differs from KEITARO_URL
# KEITARO_ADMIN_URL=

# Campaign creator: domain, group and traffic source are found in Keitaro by name
CAMPAIGN_DOMAIN=in.posdk.xyz
CAMPAIGN_GROUP=FORTESTS
CAMPAIGN_SOURCE=FORTESTS
CAMPAIGN_GEO_REDIRECT_URL=https://google.com
